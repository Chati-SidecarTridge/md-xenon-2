# The restart point: when the first life is lost (the lives byte $CCB
# changes), print the scroll variables and arm a one-shot watch on the map
# offset ($CCE) that logs the code resetting it. Run with --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
stage restart-start.ini
stage restart-death.ini
stage regs.ini
debug b pc = $7a50 :once :trace :file {run}/restart-start.ini
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
fire
sleep 2
fire
sleep 2
fire
sleep 10
