# Who rewrites the map while level 1 plays: one-shot watches on two map
# words that change (rows 250 and 109 of the map), logging the registers,
# the PC and the stack. The ship is kept alive and off the scenery as in
# level-run.exp. Run with --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
stage map-writer-start.ini
stage map-writer-hit.ini
stage keep-lives.ini
stage level-run-shield.ini
stage level-run-nodeath.ini
stage level-run-nowall.ini
debug b pc = $7a50 :once :trace :file {run}/map-writer-start.ini
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
fire
sleep 2
fire
sleep 2
fire
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
