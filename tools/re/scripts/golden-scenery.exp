# Golden scenery: the back buffer right after the scenery drawer returns
# ($7A86, before sprites, stars and the status bar are drawn) at the 120th,
# 600th and 3000th frame of play (past the mid-level shop), with the scroll
# variables ($CCE, $CD6, $436) and the palette. The ship is kept alive and
# off the scenery and the shop skipped, as in level-run.exp; the fire latch
# is set once a second. Another frame: change a number in
# golden-scenery-start.ini. Compare: render_level.py LEVEL1.X2 --dump
# <run>/scenery-f3000. Run with --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
stage golden-scenery-start.ini
stage golden-scenery-f120.ini
stage golden-scenery-f600.ini
stage golden-scenery-f3000.ini
stage level-run-shield.ini
stage level-run-nodeath.ini
stage level-run-nowall.ini
stage level-run-noshop.ini
stage keep-lives.ini
debug b pc = $7a50 :once :trace :file {run}/golden-scenery-start.ini
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
fire
sleep 2
fire
sleep 2
fire
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
