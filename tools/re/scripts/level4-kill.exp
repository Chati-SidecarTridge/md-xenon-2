# Level 4's bosses destroyed as the original runs it: level4-objs.exp with
# every boss part's hit points set to 1 at level 4's second frame (the
# parts' tables, after the level's start has filled them in), so the ship's
# bullets destroy them; the ship under the pods and the chain as there, then
# under the end boss's claws (x 128 at line 60, 192 once one claw is gone,
# 160 once both are). Logged as level4-objs.exp.
# Run with --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
stage level4-jump.ini
stage level4-hp1.ini
stage level4-hold.ini
stage level4-x120.ini
stage level4-x200.ini
stage level4-x160.ini
stage level4-x128.ini
stage level4-x192.ini
stage level4-kill-start.ini
stage level2-frame.ini
stage waves-kill.ini
stage weapons-take.ini
stage level2-obj.ini
stage level-run-shield.ini
stage level-run-nodeath.ini
stage level-run-nowall.ini
stage level-run-noshop.ini
# Hatari 2.6 loses its breakpoints when a hit adds the 16th (it grows the
# array without copying it): grow it here (to 32), outside any hit, then
# clear it.
debug b pc = $1
debug b pc = $2
debug b pc = $3
debug b pc = $4
debug b pc = $5
debug b pc = $6
debug b pc = $7
debug b pc = $8
debug b pc = $9
debug b pc = $a
debug b pc = $b
debug b pc = $c
debug b pc = $d
debug b pc = $e
debug b pc = $f
debug b pc = $10
debug b pc = $11
debug b pc = $12
debug b pc = $13
debug b pc = $14
debug b pc = $15
debug b pc = $16
debug b pc = $17
debug b pc = $18
debug b pc = $19
debug b pc = $1a
debug b pc = $1b
debug b pc = $1c
debug b pc = $1d
debug b pc = $1e
debug b pc = $1f
debug b pc = $20
debug b pc = $21
debug b pc = $22
debug b pc = $23
debug b pc = $24
debug b pc = $25
debug b pc = $26
debug b pc = $27
debug b pc = $28
debug b all
debug b pc = $7a50 :once :trace :file {run}/level4-kill-start.ini
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
fire
sleep 2
