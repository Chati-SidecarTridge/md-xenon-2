# The ship's numbers: every frame the ship's x, y and bank, the stick byte
# the fire count and the speed-ups ($C9E); every shot's frame; every bullet's y as it moves. The
# stick is driven by writing the game's stick byte ($A00: 1 up, 2 down,
# 4 left, 8 right, $80 fire), which the IKBD handler only rewrites when the
# real stick changes. The ship is kept alive and off the scenery as in
# level-run.exp. Run with --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
stage ship-measure-start.ini
stage ship-measure-frame.ini
stage ship-measure-shot.ini
stage ship-measure-bullet.ini
stage level-run-shield.ini
stage level-run-nodeath.ini
stage level-run-nowall.ini
debug b pc = $1
debug b pc = $2
debug b pc = $3
debug b pc = $4
debug b pc = $5
debug b pc = $6
debug b pc = $7
debug b pc = $8
debug b pc = $9
debug b pc = $a
debug b pc = $b
debug b pc = $c
debug b pc = $d
debug b pc = $e
debug b pc = $f
debug b pc = $10
debug b pc = $11
debug b pc = $12
debug b pc = $13
debug b pc = $14
debug b all
debug b pc = $7a50 :once :trace :file {run}/ship-measure-start.ini
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
fire
sleep 2
fire
sleep 2
fire
sleep 1
debug w $a00 $08
sleep 0.4
debug w $a00 $00
sleep 1
debug w $a00 $04
sleep 0.4
debug w $a00 $00
sleep 1
debug w $a00 $08
sleep 1
debug w $a00 $00
sleep 1
debug w $a00 $04
sleep 1
debug w $a00 $00
sleep 1
debug w $a00 $01
sleep 1
debug w $a00 $02
sleep 1
debug w $a00 $80
sleep 2
debug w $a00 $00
sleep 1
