# Who rewrites the resident block (the level stream's first 18 virtual
# sectors at $32d5c) between the disk-2 poll and "get ready"? A watchpoint
# armed at the poll prints the registers at every change of its first long.
# Run with --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
stage regs.ini
debug b ($32d5c).l ! ($32d5c).l :trace :file {run}/regs.ini
debug b ($32d60).l ! ($32d60).l :trace :file {run}/regs.ini
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
