# Golden frames in flight: from level 1's 20th frame the stick is held up,
# right and fire (the game's stick byte $A00 = $89); frames 60 and 61 are
# saved whole with the scroll, the game's variables, the stars, the list
# heads and nodes ($A00, 1 KB) and the object pool ($38000, 12 KB), so the
# ship, its flames and its bullets can be drawn from them. The ship is kept
# alive and off the scenery as in level-run.exp. Run with --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
stage golden-fly-start.ini
stage golden-fly-f60.ini
stage golden-fly-f61.ini
stage level-run-shield.ini
stage level-run-nodeath.ini
stage level-run-nowall.ini
debug b pc = $7a50 :once :trace :file {run}/golden-fly-start.ini
debug b pc = $7a58 && ($cdc).w = 20 :once :trace :file {run}/golden-fly-stick.ini
stage golden-fly-stick.ini
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
fire
sleep 2
fire
sleep 2
fire
sleep 6
