# The player's weapons as the original runs them: level 1 with the ship kept
# alive, still and firing (as level-run.exp); at the level's start the seven
# capsules are made to hold the tokens 7, 9, 13, 8, 10, 16, 6 (the still
# ship takes the last four). Every frame ($3E42): the frame, the world line,
# the fire button ($A00), the shot request ($A6A), the ship and the random
# generator ($289C); every token taken ($4FF8); every target a homing
# missile picks ($424C); every player projectile and weapon as its update
# starts: bullets $6086, flames $5FF2, bombs $4B12, homing missiles $4210,
# laser beams $4848, cannon shells $4E50, mines and their layer $4BAC, the
# pods $4902 $47A8 $49C8, the drone $454A, the electro ball $469A. For
# checking the weapons code frame by frame.
# Run with --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
stage weapons-d-start.ini
stage weapons-frame.ini
stage weapons-take.ini
stage weapons-pick.ini
stage weapons-obj.ini
stage level-run-row.ini
stage level-run-pal.ini
stage level-run-life.ini
stage level-run-shield.ini
stage level-run-nodeath.ini
stage level-run-nowall.ini
stage level-run-noshop.ini
stage level-run-flags.ini
stage level-run-speed.ini
# Hatari 2.6 loses its breakpoints when a hit adds the 16th (it grows the
# array without copying it): grow it here, outside any hit, then clear it.
debug b pc = $1
debug b pc = $2
debug b pc = $3
debug b pc = $4
debug b pc = $5
debug b pc = $6
debug b pc = $7
debug b pc = $8
debug b pc = $9
debug b pc = $a
debug b pc = $b
debug b pc = $c
debug b pc = $d
debug b pc = $e
debug b pc = $f
debug b pc = $10
debug b pc = $11
debug b pc = $12
debug b pc = $13
debug b pc = $14
debug b pc = $15
debug b pc = $16
debug b all
debug b pc = $7a50 :once :trace :file {run}/weapons-d-start.ini
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
fire
sleep 2
fire
sleep 2
