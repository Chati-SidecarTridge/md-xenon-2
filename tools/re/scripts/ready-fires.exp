# "Get ready player 1" takes several fire presses (its display script has
# more than one wait-for-fire step); screenshots in between. --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
shot r0
fire
sleep 1
shot r1
sleep 1
shot r2
fire
sleep 1
shot r3
sleep 2
shot r4
fire
sleep 2
shot r5
debug e VBL
debug m w $410 1
debug m l $406 2
