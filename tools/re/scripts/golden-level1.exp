# Golden frames "level1-f120" and "level1-f600": level 1 at the 120th and
# 600th frame of play (the game's frame counter at $CDC, from the start of
# play), the frame just drawn (the back buffer at the level loop's frame
# call, $7BF6), no stick input; the lives byte is held so the game goes on,
# and the fire latch ($A01) is set once a second so the "get ready" screen
# after a death does not stop it.
# The scenery is fixed by the frame count; enemies and their shots may
# differ from run to run. Run with --trace fdc; then:
#   golden.py RUN level1-f120   and   golden.py RUN level1-f600
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
stage golden-level1-start.ini
stage golden-level1-f120.ini
stage golden-level1-f600.ini
stage keep-lives.ini
debug b pc = $7a50 :once :trace :file {run}/golden-level1-start.ini
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
fire
sleep 2
fire
sleep 2
fire
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
debug w $a01 $ff
sleep 1
