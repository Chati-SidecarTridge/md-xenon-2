# Level 1 with its sound: from the start of play, 40 seconds recorded, the
# fire held for the first 10 (the gun's effect), then the ship left alone
# (the enemies' sounds, a death). Run with --sound --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
record play
fire
sleep 2
fire
sleep 2
fire
fire 10
sleep 30
record
