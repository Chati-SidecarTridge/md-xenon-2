# Who draws the dots over level 1's scenery: the screen saved in frame 1
# after the objects are drawn ($7A8A), after the level's own code ($7A9C)
# and after the small shots ($7AA8). Run with --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
stage who-draws-dots-start.ini
stage who-draws-dots-a.ini
stage who-draws-dots-b.ini
stage who-draws-dots-c.ini
debug b pc = $7a50 :once :trace :file {run}/who-draws-dots-start.ini
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
fire
sleep 2
fire
sleep 2
fire
sleep 4
