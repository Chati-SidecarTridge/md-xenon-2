# Level 1's sound as register writes and as audio together: Hatari's
# psg_write trace and a recording of the first seconds of play, fire held
# for a while (the gun's effect). Run with --sound --trace fdc,psg_write.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
record play
fire
sleep 2
fire
sleep 2
fire
fire 2
sleep 3
record
