# Level 1 to its mid-level shop with the ship kept alive (as level-run.exp,
# but the shop not skipped), still and not firing; the shop left alone:
# screenshots in it every 5 s. Logged: entering the shop ($10520) and every
# return to the level loop after it ($7DA6), with the VBL counter. For the
# shop's pictures and timing.
# Run with --trace fdc.
expect prompt read sector sector=0x1 .*tr=0x0 .*addr=0x6760e
stage shop-look-start.ini
stage shop-look-log.ini
stage level-run-row.ini
stage level-run-pal.ini
stage level-run-life.ini
stage level-run-shield.ini
stage level-run-nodeath.ini
stage level-run-nowall.ini
stage level-run-flags.ini
stage level-run-speed.ini
# Hatari 2.6 loses its breakpoints when a hit adds the 16th (it grows the
# array without copying it): grow it here, outside any hit, then clear it.
debug b pc = $1
debug b pc = $2
debug b pc = $3
debug b pc = $4
debug b pc = $5
debug b pc = $6
debug b pc = $7
debug b pc = $8
debug b pc = $9
debug b pc = $a
debug b pc = $b
debug b pc = $c
debug b pc = $d
debug b pc = $e
debug b pc = $f
debug b pc = $10
debug b pc = $11
debug b pc = $12
debug b pc = $13
debug b pc = $14
debug b pc = $15
debug b pc = $16
debug b all
debug b pc = $7a50 :once :trace :file {run}/shop-look-start.ini
disk-a {disk2}
sleep 8
fire
sleep 4
fire
expect level1-read read sector sector=0x3 .*tr=0xc .*addr=0x3e
quiet level1-loaded 3
fire
sleep 2
fire
sleep 2
fire
sleep 10
sleep 10
sleep 10
sleep 10
sleep 10
sleep 10
sleep 10
sleep 10
sleep 10
sleep 10
sleep 10
sleep 10
sleep 5
shot shop-0
sleep 5
shot shop-1
sleep 5
shot shop-2
sleep 5
shot shop-3
sleep 5
shot shop-4
sleep 5
shot shop-5
sleep 5
shot shop-6
sleep 5
shot shop-7
